# Vite environment variables for the web app.
# Only variables prefixed with VITE_ are exposed to the client bundle.
# Copy this file to `.env` (or `.env.local`) and adjust values as needed.

# Base URL for the Laravel backend API.
VITE_API_BASE_URL=http://127.0.0.1:8001

# Example feature flag.
# VITE_FEATURE_FOO=false
