# Mobile (Expo) environment variables
#
# Expo loads variables from `.env`, `.env.local`, `.env.<mode>`, and
# `.env.<mode>.local` files at the root of the `mobile/` directory.
#
# Only variables prefixed with `EXPO_PUBLIC_` are inlined into the JS
# bundle and exposed to client code via `process.env.EXPO_PUBLIC_*`.
# Do NOT put secrets in EXPO_PUBLIC_* variables — anything prefixed
# with EXPO_PUBLIC_ is shipped to the device in plain text.
#
# Build/EAS-only secrets should be configured via EAS secrets
# (https://docs.expo.dev/build-reference/variables/) instead of this file.

# Example: URL of the local Laravel backend during development.
EXPO_PUBLIC_API_URL=http://localhost:8000
