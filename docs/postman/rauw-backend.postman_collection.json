{
  "info": {
    "_postman_id": "0a63f8e0-40d3-4b2a-9f70-491c3af7e58a",
    "name": "RAUW Backend API",
    "description": "Backend-only RAUW API collection. Starts with bearer token authentication requests and can be expanded as new backend endpoints are added.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Officer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Officer registration succeeded', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const response = pm.response.json();",
                  "",
                  "pm.test('Response contains bearer token and officer profile', function () {",
                  "    pm.expect(response.token_type).to.eql('Bearer');",
                  "    pm.expect(response.access_token).to.be.a('string').and.not.empty;",
                  "    pm.expect(response.actor_type).to.eql('officer');",
                  "    pm.expect(response.profile).to.be.an('object');",
                  "    pm.expect(response.profile.actor_type).to.eql('officer');",
                  "});",
                  "",
                  "if (response.access_token) {",
                  "    pm.collectionVariables.set('access_token', response.access_token);",
                  "",
                  "    if (pm.environment.name) {",
                  "        pm.environment.set('access_token', response.access_token);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"new-officer\",\n  \"email\": \"new.officer@example.com\",\n  \"password\": \"password123\",\n  \"confirm_password\": \"password123\",\n  \"badge_number\": \"BOA-1234\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register/officer",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "register",
                "officer"
              ]
            },
            "description": "Register a backend API-only officer account with username, email, password, confirm_password, and badge_number. The 201 response includes token_type, access_token, actor_type, and the same safe officer profile serializer used by login. The test script stores access_token in collection and active environment variables. Change username, email, and badge_number before rerunning because each must be unique within officers."
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login succeeded', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const response = pm.response.json();",
                  "",
                  "pm.test('Response contains bearer token and profile', function () {",
                  "    pm.expect(response.token_type).to.eql('Bearer');",
                  "    pm.expect(response.access_token).to.be.a('string').and.not.empty;",
                  "    pm.expect(['user', 'officer', 'manager']).to.include(response.actor_type);",
                  "    pm.expect(response.profile).to.be.an('object');",
                  "});",
                  "",
                  "if (response.access_token) {",
                  "    pm.collectionVariables.set('access_token', response.access_token);",
                  "",
                  "    if (pm.environment.name) {",
                  "        pm.environment.set('access_token', response.access_token);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo.user@example.com\",\n  \"password\": \"password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Authenticate with email and password only. The response includes token_type, access_token, actor_type, and profile. The test script stores access_token in collection and active environment variables."
          },
          "response": []
        },
        {
          "name": "Current Profile",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            },
            "description": "Return the authenticated actor_type and safe profile payload. Requires Authorization: Bearer <token>."
          },
          "response": []
        },
        {
          "name": "Logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Logout succeeded', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    pm.collectionVariables.set('access_token', '');",
                  "",
                  "    if (pm.environment.name) {",
                  "        pm.environment.set('access_token', '');",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "logout"
              ]
            },
            "description": "Revoke the bearer token used by this request. Requires Authorization: Bearer <token>."
          },
          "response": []
        }
      ],
      "description": "Authentication requests for user, officer, and manager actors."
    }
  ],
  "auth": {
    "type": "noauth"
  },
  "event": [],
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8001",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    }
  ]
}
