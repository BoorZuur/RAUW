{
  "info": {
    "_postman_id": "0a63f8e0-40d3-4b2a-9f70-491c3af7e58a",
    "name": "RAUW Backend API",
    "description": "Backend-only RAUW API collection. Starts with bearer token authentication requests and can be expanded as new backend endpoints are added.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Officer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Officer registration succeeded', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const response = pm.response.json();",
                  "",
                  "pm.test('Response contains bearer token and officer profile', function () {",
                  "    pm.expect(response.token_type).to.eql('Bearer');",
                  "    pm.expect(response.access_token).to.be.a('string').and.not.empty;",
                  "    pm.expect(response.actor_type).to.eql('officer');",
                  "    pm.expect(response.profile).to.be.an('object');",
                  "    pm.expect(response.profile.actor_type).to.be.undefined;",
                  "    pm.expect(response.profile.is_active).to.be.undefined;",
                  "    pm.expect(response.profile.district_id).to.be.undefined;",
                  "});",
                  "",
                  "if (response.access_token) {",
                  "    pm.collectionVariables.set('access_token', response.access_token);",
                  "",
                  "    if (pm.environment.name) {",
                  "        pm.environment.set('access_token', response.access_token);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"new-officer\",\n  \"email\": \"new.officer@example.com\",\n  \"password\": \"password123\",\n  \"confirm_password\": \"password123\",\n  \"badge_number\": \"BOA-1234\",\n  \"department_ids\": [1]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register/officer",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "register",
                "officer"
              ]
            },
            "description": "Register a backend API-only officer account with username, email, password, confirm_password, badge_number, and department_ids. department_ids is required, must contain at least one existing department ID, and cannot contain duplicates; officers must have one or more departments. The 201 response includes token_type, access_token, actor_type, and a cleaned safe officer profile with departments as compact objects. The test script stores access_token in collection and active environment variables. Change username, email, and badge_number before rerunning because username and badge_number must be unique within officers and email must be unique across users, officers, and managers."
          },
          "response": []
        },
        {
          "name": "Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('User registration succeeded', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const response = pm.response.json();",
                  "",
                  "pm.test('Response contains bearer token and user profile', function () {",
                  "    pm.expect(response.token_type).to.eql('Bearer');",
                  "    pm.expect(response.access_token).to.be.a('string').and.not.empty;",
                  "    pm.expect(response.actor_type).to.eql('user');",
                  "    pm.expect(response.profile).to.be.an('object');",
                  "    pm.expect(response.profile.actor_type).to.be.undefined;",
                  "    pm.expect(response.profile.is_active).to.be.undefined;",
                  "    pm.expect(response.profile.email_verified_at).to.be.undefined;",
                  "});",
                  "",
                  "if (response.access_token) {",
                  "    pm.collectionVariables.set('access_token', response.access_token);",
                  "",
                  "    if (pm.environment.name) {",
                  "        pm.environment.set('access_token', response.access_token);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New User\",\n  \"username\": \"new-user\",\n  \"email\": \"new.user@example.com\",\n  \"password\": \"password123\",\n  \"confirm_password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register/user",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "register",
                "user"
              ]
            },
            "description": "Register a public API user account with name, username, email, password, and confirm_password. The 201 response includes token_type, access_token, actor_type, and a cleaned safe user profile that does not duplicate actor_type or expose internal auth fields. The test script stores access_token in collection and active environment variables. Change username and email before rerunning because username must be unique within users and email must be unique across users, officers, and managers."
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login succeeded', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const response = pm.response.json();",
                  "",
                  "pm.test('Response contains bearer token and profile', function () {",
                  "    pm.expect(response.token_type).to.eql('Bearer');",
                  "    pm.expect(response.access_token).to.be.a('string').and.not.empty;",
                  "    pm.expect(['user', 'officer', 'manager']).to.include(response.actor_type);",
                  "    pm.expect(response.profile).to.be.an('object');",
                  "    pm.expect(response.profile.actor_type).to.be.undefined;",
                  "    pm.expect(response.profile.is_active).to.be.undefined;",
                  "    pm.expect(response.profile.email_verified_at).to.be.undefined;",
                  "    pm.expect(response.profile.district_id).to.be.undefined;",
                  "    pm.expect(response.profile.created_by_manager_id).to.be.undefined;",
                  "});",
                  "",
                  "if (response.access_token) {",
                  "    pm.collectionVariables.set('access_token', response.access_token);",
                  "",
                  "    if (pm.environment.name) {",
                  "        pm.environment.set('access_token', response.access_token);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo.user@example.com\",\n  \"password\": \"password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Authenticate with email and password only. The response includes token_type, access_token, actor_type, and a cleaned profile. actor_type is only present at the top level; profile omits internal auth fields. The test script stores access_token in collection and active environment variables."
          },
          "response": []
        },
        {
          "name": "Current Profile",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            },
            "description": "Return the authenticated actor_type and cleaned safe profile payload. actor_type is only present at the top level; profile omits internal auth fields. Requires Authorization: Bearer <token>."
          },
          "response": []
        },
        {
          "name": "Logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Logout succeeded', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    pm.collectionVariables.set('access_token', '');",
                  "",
                  "    if (pm.environment.name) {",
                  "        pm.environment.set('access_token', '');",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "logout"
              ]
            },
            "description": "Revoke the bearer token used by this request. Requires Authorization: Bearer <token>."
          },
          "response": []
        }
      ],
      "description": "Authentication requests for user, officer, and manager actors."
    },
    {
      "name": "Managers",
      "item": [
        {
          "name": "Create Manager",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Manager creation succeeded', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const response = pm.response.json();",
                  "",
                  "pm.test('Response contains created manager profile only', function () {",
                  "    pm.expect(response.actor_type).to.eql('manager');",
                  "    pm.expect(response.id).to.exist;",
                  "    pm.expect(response.username).to.be.a('string').and.not.empty;",
                  "    pm.expect(response.email).to.be.a('string').and.not.empty;",
                  "    pm.expect(response.is_main_manager).to.eql(false);",
                  "    pm.expect(response.created_by_manager_id).to.exist;",
                  "    pm.expect(response.access_token).to.be.undefined;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"new-manager\",\n  \"email\": \"new.manager@example.com\",\n  \"password\": \"password123\",\n  \"confirm_password\": \"password123\",\n  \"department_id\": 1,\n  \"district_id\": null\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/managers",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "managers"
              ]
            },
            "description": "Create an ordinary manager as the authenticated main manager. Requires Authorization: Bearer <token> from an active manager with is_main_manager=true. department_id is required and must reference an existing department; each manager has exactly one department. The 201 response returns the created manager profile only, including department_id plus compact department data, and does not include or store an access_token. The new manager must log in separately through Auth / Login. Change username and email before rerunning because username must be unique within managers and email must be unique across users, officers, and managers."
          },
          "response": []
        }
      ],
      "description": "Protected manager administration requests. Manager creation is restricted to authenticated active main managers."
    },
    {
      "name": "Categories",
      "item": [
        {
          "name": "List Categories",
          "request": {
            "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{access_token}}", "type": "string" } ] },
            "method": "GET",
            "header": [ { "key": "Accept", "value": "application/json", "type": "text" } ],
            "url": { "raw": "{{base_url}}/api/categories", "host": [ "{{base_url}}" ], "path": [ "api", "categories" ] },
            "description": "List categories as an authenticated active manager. Main categories are ordered by priority and children by weight; lower numbers mean higher priority. Responses include assigned departments from the category_department pivot."
          },
          "response": []
        },
        {
          "name": "Show Category",
          "request": {
            "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{access_token}}", "type": "string" } ] },
            "method": "GET",
            "header": [ { "key": "Accept", "value": "application/json", "type": "text" } ],
            "url": { "raw": "{{base_url}}/api/categories/1", "host": [ "{{base_url}}" ], "path": [ "api", "categories", "1" ] },
            "description": "Show one category with parent, children when loaded, and assigned departments. Requires an authenticated active manager."
          },
          "response": []
        },
        {
          "name": "Create Main Category",
          "request": {
            "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{access_token}}", "type": "string" } ] },
            "method": "POST",
            "header": [ { "key": "Accept", "value": "application/json", "type": "text" }, { "key": "Content-Type", "value": "application/json", "type": "text" } ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Openbare ruimte\",\n  \"parent_id\": null,\n  \"department_ids\": [1],\n  \"priority\": 10,\n  \"is_active\": true\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{base_url}}/api/categories", "host": [ "{{base_url}}" ], "path": [ "api", "categories" ] },
            "description": "Create a main category as an authenticated active manager. Main categories use priority; lower values sort first. department_ids must contain existing departments."
          },
          "response": []
        },
        {
          "name": "Create Subcategory",
          "request": {
            "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{access_token}}", "type": "string" } ] },
            "method": "POST",
            "header": [ { "key": "Accept", "value": "application/json", "type": "text" }, { "key": "Content-Type", "value": "application/json", "type": "text" } ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Losliggende stoeptegel\",\n  \"parent_id\": 1,\n  \"department_ids\": [1, 2],\n  \"weight\": 5,\n  \"is_active\": true\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{base_url}}/api/categories", "host": [ "{{base_url}}" ], "path": [ "api", "categories" ] },
            "description": "Create a subcategory under an active main category. Nested subcategories are rejected. Subcategories use weight; lower values sort first."
          },
          "response": []
        },
        {
          "name": "Update Category",
          "request": {
            "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{access_token}}", "type": "string" } ] },
            "method": "PATCH",
            "header": [ { "key": "Accept", "value": "application/json", "type": "text" }, { "key": "Content-Type", "value": "application/json", "type": "text" } ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Openbare ruimte bijgewerkt\",\n  \"department_ids\": [1, 2],\n  \"priority\": 1\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{base_url}}/api/categories/1", "host": [ "{{base_url}}" ], "path": [ "api", "categories", "1" ] },
            "description": "Partially update a category as an authenticated active manager. If department_ids is present, it replaces the category's pivot assignments."
          },
          "response": []
        },
        {
          "name": "Disable Category",
          "request": {
            "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{access_token}}", "type": "string" } ] },
            "method": "PATCH",
            "header": [ { "key": "Accept", "value": "application/json", "type": "text" } ],
            "url": { "raw": "{{base_url}}/api/categories/1/disable", "host": [ "{{base_url}}" ], "path": [ "api", "categories", "1", "disable" ] },
            "description": "Standard safe removal path. Sets is_active=false while keeping the category row, department assignments, and historical issue references intact."
          },
          "response": []
        },
        {
          "name": "Hard Delete Category",
          "request": {
            "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{access_token}}", "type": "string" } ] },
            "method": "DELETE",
            "header": [ { "key": "Accept", "value": "application/json", "type": "text" } ],
            "url": { "raw": "{{base_url}}/api/categories/1", "host": [ "{{base_url}}" ], "path": [ "api", "categories", "1" ] },
            "description": "Guarded hard delete for eligible categories only. Prefer Disable Category. A main category with subcategories returns 409, and categories referenced by existing issues also return 409."
          },
          "response": []
        }
      ],
      "description": "Category management requests. Requires an authenticated active manager. Categories are assigned to departments through a many-to-many pivot. Disable is the standard removal path; hard delete is guarded."
    },
    {
      "name": "Departments",
      "item": [
        {
          "name": "List Departments",
          "request": {
            "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{access_token}}", "type": "string" } ] },
            "method": "GET",
            "header": [ { "key": "Accept", "value": "application/json", "type": "text" } ],
            "url": { "raw": "{{base_url}}/api/departments", "host": [ "{{base_url}}" ], "path": [ "api", "departments" ] },
            "description": "List departments from the departments table with category counts. Requires authentication in the protected API group."
          },
          "response": []
        },
        {
          "name": "Show Department",
          "request": {
            "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{access_token}}", "type": "string" } ] },
            "method": "GET",
            "header": [ { "key": "Accept", "value": "application/json", "type": "text" } ],
            "url": { "raw": "{{base_url}}/api/departments/1", "host": [ "{{base_url}}" ], "path": [ "api", "departments", "1" ] },
            "description": "Show one department with category count. Requires authentication in the protected API group."
          },
          "response": []
        },
        {
          "name": "Create Department",
          "request": {
            "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{access_token}}", "type": "string" } ] },
            "method": "POST",
            "header": [ { "key": "Accept", "value": "application/json", "type": "text" }, { "key": "Content-Type", "value": "application/json", "type": "text" } ],
            "body": { "mode": "raw", "raw": "{\n  \"code\": \"groenbeheer\",\n  \"name\": \"Groenbeheer\",\n  \"is_active\": true\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{base_url}}/api/departments", "host": [ "{{base_url}}" ], "path": [ "api", "departments" ] },
            "description": "Create a department. Requires an authenticated active main manager (is_main_manager=true). Ordinary managers, users, officers, inactive managers, and unauthenticated requests cannot mutate departments."
          },
          "response": []
        },
        {
          "name": "Update Department",
          "request": {
            "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{access_token}}", "type": "string" } ] },
            "method": "PATCH",
            "header": [ { "key": "Accept", "value": "application/json", "type": "text" }, { "key": "Content-Type", "value": "application/json", "type": "text" } ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Groenbeheer bijgewerkt\",\n  \"is_active\": true\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{base_url}}/api/departments/1", "host": [ "{{base_url}}" ], "path": [ "api", "departments", "1" ] },
            "description": "Update a department. Requires an authenticated active main manager."
          },
          "response": []
        },
        {
          "name": "Delete Department",
          "request": {
            "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{access_token}}", "type": "string" } ] },
            "method": "DELETE",
            "header": [ { "key": "Accept", "value": "application/json", "type": "text" } ],
            "url": { "raw": "{{base_url}}/api/departments/1", "host": [ "{{base_url}}" ], "path": [ "api", "departments", "1" ] },
            "description": "Delete a department as an authenticated active main manager. Departments assigned to any manager or officer return 409 until those actor assignments are changed. After no actors reference the department, database cascade removes category_department assignments automatically; category records remain intact."
          },
          "response": []
        }
      ],
      "description": "Department CRUD requests. Department mutations require an authenticated active main manager. Managers use one required department_id; officers use department_ids through the department_officer pivot and must have one or more departments. Deleting a department is blocked while assigned to managers or officers; otherwise it removes category_department pivot assignments automatically but does not delete categories. Issue department migration is intentionally deferred to a later plan, so issue department fields may still use the legacy enum/string contract."
    }
  ],
  "auth": {
    "type": "noauth"
  },
  "event": [],
